@{
    ViewData["Title"] = "Panel de Cajero";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 p-5 text-center">
        <div class="mb-4">
            <i class="fas fa-cash-register text-primary" style="font-size: 4rem;"></i>
        </div>
        <h2 class="fw-bold">Módulo de Cajero</h2>
        <p class="text-muted">Estado: Pendiente de implementación.</p>
        <p>Hola, <strong>@User.Identity.Name</strong>. Este módulo será implementado por el Dev 1 para gestionar depósitos y retiros.</p>
        <div class="mt-4">
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">Cerrar Sesión</a>
        </div>
    </div>
</div>
