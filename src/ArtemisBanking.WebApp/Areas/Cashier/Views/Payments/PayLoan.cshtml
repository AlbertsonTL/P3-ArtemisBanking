@using ArtemisBanking.WebApp.ViewModels.Cashier
@model LoanPaymentViewModel
@{
    ViewData["Title"] = "Pago a Préstamo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" asp-controller="Home" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-info bg-opacity-10 border-bottom-0 pt-4 px-4 text-center">
                <div class="bg-info-subtle text-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fas fa-handshake fs-4"></i>
                </div>
                <h4 class="fw-bold text-slate-800 mb-0">Pago a Préstamo</h4>
                <p class="text-muted small">Ingresa los datos del pago</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="PayLoan" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="AccountNumber" class="form-label fw-bold">Número de Cuenta Origen</label>
                        <input asp-for="AccountNumber" class="form-control form-control-lg" placeholder="9 dígitos" maxlength="9" />
                        <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LoanNumber" class="form-label fw-bold">Número del Préstamo</label>
                        <input asp-for="LoanNumber" class="form-control form-control-lg" placeholder="9 dígitos" maxlength="9" />
                        <span asp-validation-for="LoanNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold">Monto a Pagar (RD$)</label>
                        <input asp-for="Amount" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-info w-100 py-3 fw-bold rounded-3">
                        <i class="fas fa-check me-2"></i> Continuar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
