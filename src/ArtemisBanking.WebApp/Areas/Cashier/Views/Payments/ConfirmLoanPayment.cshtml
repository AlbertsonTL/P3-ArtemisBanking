@using ArtemisBanking.WebApp.ViewModels.Cashier
@model LoanPaymentConfirmationViewModel
@{
    ViewData["Title"] = "Confirmar Pago a Préstamo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="PayLoan" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-info bg-opacity-10 border-bottom-0 pt-4 px-4 text-center">
                <div class="bg-info-subtle text-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fas fa-check-circle fs-4"></i>
                </div>
                <h4 class="fw-bold text-slate-800 mb-0">Confirmar Pago</h4>
                <p class="text-muted small">Verifica los datos antes de procesar</p>
            </div>
            <div class="card-body p-4">
                <div class="bg-light border border-info border-opacity-25 rounded-3 p-4 mb-4">
                    <h6 class="fw-bold text-slate-800 mb-3">Información del Préstamo</h6>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted d-block">Titular del Préstamo</small>
                            <p class="fw-bold text-slate-800 mb-0">@Model.LoanHolderName</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Número de Préstamo</small>
                            <p class="fw-bold text-slate-800 mb-0">@Model.LoanNumber</p>
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <h6 class="fw-bold text-slate-800 mb-3">Estado del Préstamo</h6>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted d-block">Deuda Pendiente</small>
                            <p class="fw-bold text-slate-800 mb-0">RD$ @Model.RemainingDebt.ToString("N2")</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Cuotas Pendientes</small>
                            <p class="fw-bold text-slate-800 mb-0">@Model.PendingQuotas</p>
                        </div>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <h6 class="fw-bold text-slate-800 mb-3">Detalles del Pago</h6>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted d-block">Monto Solicitado</small>
                            <p class="fw-bold text-slate-800 mb-0">RD$ @Model.Amount.ToString("N2")</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Monto a Pagar</small>
                            <p class="fw-bold text-info h5 mb-0">RD$ @Model.ActualAmountToCharge.ToString("N2")</p>
                        </div>
                    </div>

                    @if (Model.ExcessAmount > 0)
                    {
                        <hr class="my-3 opacity-25" />
                        <div class="row">
                            <div class="col-12">
                                <small class="text-muted d-block">Excedente a Retornar</small>
                                <p class="fw-bold text-success h5 mb-0">RD$ @Model.ExcessAmount.ToString("N2")</p>
                            </div>
                        </div>
                        <div class="alert alert-success small mt-3 mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Nota:</strong> El excedente será retornado automáticamente a la cuenta de origen.
                        </div>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <form asp-action="ConfirmPayment" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-info w-100 py-3 fw-bold rounded-3 shadow-sm">
                                <i class="fas fa-check me-2"></i> Confirmar
                            </button>
                        </form>
                    </div>
                    <div class="col-6">
                        <form asp-action="CancelPayment" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100 py-3 fw-bold rounded-3">
                                <i class="fas fa-times me-2"></i> Cancelar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
