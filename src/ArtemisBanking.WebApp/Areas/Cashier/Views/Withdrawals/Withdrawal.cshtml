@using ArtemisBanking.WebApp.ViewModels.Cashier
@model WithdrawalViewModel
@{
    ViewData["Title"] = "Realizar Retiro";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" asp-controller="Home" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver al inicio
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 text-center">
                <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fas fa-money-bill-alt fs-4"></i>
                </div>
                <h4 class="fw-bold text-slate-800 mb-0">Realizar Retiro</h4>
                <p class="text-muted small">Ingresa los datos de la cuenta origen</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Withdrawal" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="AccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <input asp-for="AccountNumber" class="form-control" placeholder="123456789" maxlength="9" />
                        <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Ingresa el número de cuenta de 9 dígitos</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold small text-slate-600"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">RD$</span>
                            <input asp-for="Amount" class="form-control border-start-0 ps-0 fw-bold" placeholder="0.00" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-3 shadow-sm">
                        <i class="fas fa-check me-2"></i> Continuar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}