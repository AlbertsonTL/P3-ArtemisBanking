@using ArtemisBanking.Domain.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Artemis</title>
    <script>try { if (localStorage.getItem('artemis-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (error) { }</script>
    <!-- Bootstrap CSS (desde CDN para asegurar estilo moderno) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="d-flex w-100">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center">
                <i class="fas fa-university text-primary fs-3 me-2"></i>
                <h4 class="mb-0 fw-bold text-dark">Artemis</h4>
            </div>

            <ul class="list-unstyled components">
                <p class="text-muted text-uppercase fw-bold px-3 mb-2 section-label">Admin Panel</p>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-chart-line"></i> Dashboard
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="fas fa-users"></i> Gestión Usuarios
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Accounts" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Accounts" asp-action="Index">
                        <i class="fas fa-piggy-bank"></i> Cuentas Ahorro
                    </a>
                </li>
                 <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Loans" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Loans" asp-action="Index">
                        <i class="fas fa-hand-holding-usd"></i> Préstamos
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cards" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Cards" asp-action="Index">
                        <i class="fas fa-credit-card"></i> Tarjetas Crédito
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div class="main-content d-flex flex-column">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg border-bottom bg-white py-3 px-4 shadow-sm top-navbar sticky-top">
                <div class="container-fluid">
                     <span class="navbar-brand mb-0 h1 fw-bold text-dark d-none d-lg-block">@ViewData["Title"]</span>
                     
                    <div class="ms-auto d-flex align-items-center">
                        <button type="button" class="theme-toggle me-3" data-theme-toggle aria-label="Cambiar a modo oscuro" aria-pressed="false">
                            <i data-theme-icon class="fas fa-moon" aria-hidden="true"></i>
                            <span data-theme-label>Modo oscuro</span>
                        </button>
                        <span class="text-muted me-3 fw-medium">
                            <i class="fas fa-user-circle me-1"></i> Hola, @User.Identity?.Name!
                        </span>
                        <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-medium">
                            Salir <i class="fas fa-sign-out-alt ms-1"></i>
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Main render body -->
            <main class="flex-grow-1 p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
