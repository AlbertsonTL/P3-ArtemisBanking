@using ArtemisBanking.Domain.Enums
@model ArtemisBanking.WebApp.ViewModels.Admin.CreateUserViewModel
@{
    ViewData["Title"] = "Crear Nuevo Usuario";
}

<div class="row justify-content-center py-4">
    <div class="col-xl-8 col-lg-10">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold text-dark mb-0">Detalles de Registro</h4>
                <p class="text-muted">Si el usuario es "Cliente", se le creará automáticamente una cuenta de ahorro principal (0 balance).</p>
            </div>
            
            <form asp-action="Create" method="post" class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">
                    <!-- Nombres y Apellidos -->
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-medium text-muted">Nombres</label>
                        <input asp-for="FirstName" class="form-control form-control-lg bg-light border-0" placeholder="Ej. Juan Marcos" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-medium text-muted">Apellidos</label>
                        <input asp-for="LastName" class="form-control form-control-lg bg-light border-0" placeholder="Ej. Pérez" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <!-- Cédula e Email -->
                    <div class="col-md-6">
                        <label asp-for="IdentityCard" class="form-label fw-medium text-muted">Cédula de Identidad</label>
                        <input asp-for="IdentityCard" class="form-control form-control-lg bg-light border-0" placeholder="000-0000000-0" />
                        <span asp-validation-for="IdentityCard" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-medium text-muted">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg bg-light border-0" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12"><hr class="text-muted opacity-25" /></div>

                    <!-- Credenciales -->
                    <div class="col-md-4">
                        <label asp-for="UserName" class="form-label fw-medium text-muted">Usuario (Login)</label>
                        <input asp-for="UserName" class="form-control form-control-lg bg-light border-0" placeholder="jperez" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Password" class="form-label fw-medium text-muted">Contraseña Temporal</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg bg-light border-0" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Role" class="form-label fw-medium text-muted">Rol del Sistema</label>
                        <select asp-for="Role" class="form-select form-select-lg bg-light border-0">
                            @foreach (var role in Enum.GetValues<UserRole>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5">
                    <a asp-action="Index" class="btn btn-light px-4 rounded-pill fw-medium">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5 rounded-pill fw-medium shadow-sm">
                        <i class="fas fa-user-plus me-2"></i> Crear Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
