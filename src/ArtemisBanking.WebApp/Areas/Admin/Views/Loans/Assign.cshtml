@model ArtemisBanking.WebApp.ViewModels.Admin.AssignLoanViewModel
@{
    ViewData["Title"] = "Asignar Préstamo Personal";
}

<div class="row justify-content-center py-4">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-warning bg-opacity-10 border-0 p-4">
                <h4 class="fw-bold text-dark mb-0"><i class="fas fa-file-signature me-2 text-warning"></i> Asignación de Préstamo</h4>
            </div>
            
            <form asp-action="Assign" method="post" class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4 position-relative">
                    <label class="form-label fw-bold text-dark">Lupa Buscar Cliente (Escriba la cédula o nombre)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="clientSearchInput" class="form-control form-control-lg bg-light border-start-0" placeholder="Ej. 000-0000000-0" autocomplete="off" maxlength="13" />
                        <input type="hidden" asp-for="ClientId" id="hiddenClientId" />
                    </div>
                    
                    <!-- Resultados de búsqueda -->
                    <div id="searchResultsList" class="list-group position-absolute w-100 shadow-lg z-3 d-none" style="margin-top: 5px; max-height: 300px; overflow-y: auto;"></div>

                    <span asp-validation-for="ClientId" class="text-danger small mt-1 d-block" id="clientErrorMsg"></span>
                    
                    <!-- Badge de Cliente Seleccionado -->
                    <div id="searchBadge" class="mt-3 animate-fade-in d-none">
                        <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon bg-success bg-opacity-20 text-success me-3" style="width: 45px; height: 45px;">
                                    <i class="fas fa-check-circle fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-success" id="clientNameShow" style="font-size: 1.1rem;"></h6>
                                    <small class="text-muted fw-medium font-monospace" id="clientCedulaShow"></small>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" onclick="clearClient()">Cambiar</button>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label asp-for="Amount" class="form-label fw-bold text-dark">Monto del Préstamo (RD$)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-0 text-muted fw-bold shadow-sm">RD$</span>
                            <input asp-for="Amount" id="Amount" class="form-control border-0 bg-light numeric-calc shadow-sm" placeholder="Ej. 50000" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AnnualInterestRate" class="form-label fw-bold text-dark">Tasa de Interés Anual (%)</label>
                        <div class="input-group input-group-lg">
                            <input asp-for="AnnualInterestRate" id="Rate" type="number" step="0.01" class="form-control border-0 bg-light numeric-calc shadow-sm" value="18.00" />
                            <span class="input-group-text bg-white border-0 text-muted fw-bold shadow-sm">%</span>
                        </div>
                        <span asp-validation-for="AnnualInterestRate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TermMonths" class="form-label fw-bold text-dark">Plazo (Meses)</label>
                        <select asp-for="TermMonths" id="Term" class="form-select form-select-lg border-0 bg-light numeric-calc shadow-sm">
                            <option value="6">6 Meses</option>
                            <option value="12">12 Meses (1 Año)</option>
                            <option value="18">18 Meses (1.5 Años)</option>
                            <option value="24">24 Meses (2 Años)</option>
                            <option value="36">36 Meses (3 Años)</option>
                            <option value="48">48 Meses (4 Años)</option>
                            <option value="60">60 Meses (5 Años)</option>
                        </select>
                        <span asp-validation-for="TermMonths" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Calculadora en Vivo -->
                <div class="alert alert-dark border-0 bg-dark text-white rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-calculator me-2 text-warning"></i> Resumen de Amortización</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">Cuota Fija Mensual Aproximada:</span>
                        <span class="fw-bold fs-4 text-warning" id="liveQuotaDisplay">RD$ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">Total de Intereses:</span>
                        <span class="fw-medium text-white" id="liveInterestDisplay">RD$ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-white-50">Total a Pagar (Capital + Intereses):</span>
                        <span class="fw-medium text-white" id="liveTotalDisplay">RD$ 0.00</span>
                    </div>
                    <hr class="border-secondary opacity-25">
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-light px-4 rounded-pill fw-medium">Cancelar</a>
                    <button type="submit" class="btn btn-warning px-5 rounded-pill fw-bold text-dark shadow-sm">
                        <i class="fas fa-check-double me-2"></i> Confirmar y Emitir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Formateador de Cédula (000-0000000-0)
        function formatCedula(input) {
            let val = input.value.replace(/\D/g, "").substring(0, 11); // Limitar a 11 dígitos reales
            let formatted = "";
            if (val.length > 0) formatted += val.substring(0, 3);
            if (val.length > 3) formatted += "-" + val.substring(3, 10);
            if (val.length > 10) formatted += "-" + val.substring(10, 11);
            input.value = formatted;
        }

        $('#clientSearchInput').on('input', function() {
            formatCedula(this);
            const term = this.value;
            const resList = $('#searchResultsList');

            if (term.length < 3) {
                resList.addClass('d-none');
                return;
            }

            // Búsqueda AJAX real al controlador
            $.get('/Admin/Loans/SearchClients', { term: term }, function(data) {
                resList.empty();
                if (data && data.length > 0) {
                    data.forEach(client => {
                        const item = $(`
                            <button type="button" class="list-group-item list-group-item-action py-3 border-start-0 border-end-0">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">${client.fullName}</div>
                                        <div class="small text-muted font-monospace">${client.identityCard}</div>
                                    </div>
                                </div>
                            </button>
                        `);
                        item.click(() => selectClient(client));
                        resList.append(item);
                    });
                    resList.removeClass('d-none');
                } else {
                    resList.addClass('d-none');
                }
            });
        });

        function selectClient(client) {
            $('#hiddenClientId').val(client.id);
            $('#clientNameShow').text(client.fullName);
            $('#clientCedulaShow').text(client.identityCard);
            $('#searchBadge').removeClass('d-none');
            $('#clientSearchInput').val('').prop('disabled', true);
            $('#searchResultsList').addClass('d-none');
            $('#clientErrorMsg').text('');
        }

        function clearClient() {
            $('#hiddenClientId').val('');
            $('#clientSearchInput').val('').prop('disabled', false).focus();
            $('#searchBadge').addClass('d-none');
        }

        function calculateLoanLive() {
            var p = parseFloat($('#Amount').val());
            var annualRate = parseFloat($('#Rate').val());
            var n = parseInt($('#Term').val());

            if(isNaN(p) || p <= 0 || isNaN(annualRate) || isNaN(n)) {
                $('#liveQuotaDisplay').text("RD$ 0.00");
                $('#liveInterestDisplay').text("RD$ 0.00");
                $('#liveTotalDisplay').text("RD$ 0.00");
                return;
            }

            var r = (annualRate / 100) / 12;
            var quota = 0;
            if(r > 0) {
                quota = p * r / (1 - Math.pow(1 + r, -n));
            } else {
                quota = p / n;
            }

            var totalToPay = quota * n;
            var totalInterests = totalToPay - p;

            $('#liveQuotaDisplay').text("RD$ " + quota.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#liveTotalDisplay').text("RD$ " + totalToPay.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#liveInterestDisplay').text("RD$ " + totalInterests.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        }

        $('.numeric-calc').on('input change', calculateLoanLive);
        
        $(document).ready(calculateLoanLive);

        $(document).click(function(e) {
            if (!$(e.target).closest('#clientSearchInput, #searchResultsList').length) {
                $('#searchResultsList').addClass('d-none');
            }
        });

        $('form').on('submit', function(e) {
            if(!$('#hiddenClientId').val()) {
                e.preventDefault();
                $('#clientErrorMsg').text('Debe buscar y seleccionar un cliente de la lista.');
            }
        });
    </script>
}
