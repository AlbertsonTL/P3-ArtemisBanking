@model ArtemisBanking.WebApp.ViewModels.Admin.RiskWarningViewModel

@{
    ViewData["Title"] = "Advertencia de Alto Riesgo";
    Layout = "_Layout";
}

<div class="container-fluid px-4 mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Encabezado de advertencia -->
            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-3 mb-4">
                <i class="fas fa-exclamation-triangle fa-2x mt-1 text-warning"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">⚠ Advertencia de Alto Riesgo Crediticio</h5>
                    <p class="mb-0">@Model.RiskMessage</p>
                </div>
            </div>

            <!-- Detalle del análisis -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="fas fa-chart-bar me-2"></i>Análisis de Riesgo
                </div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Deuda actual del cliente</div>
                                <div class="h5 fw-bold text-danger mt-1">RD$ @Model.DeudaActualCliente.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Total nuevo préstamo</div>
                                <div class="h5 fw-bold text-warning mt-1">RD$ @Model.TotalNuevoPrestamo.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Promedio del sistema</div>
                                <div class="h5 fw-bold text-success mt-1">RD$ @Model.PromedioSistema.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resumen del préstamo a confirmar -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-bold">
                    <i class="fas fa-file-invoice-dollar me-2"></i>Datos del Préstamo
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50">Cliente</th>
                                <td>@Model.ClientName</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Monto</th>
                                <td>RD$ @Model.Amount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Tasa Anual</th>
                                <td>@Model.AnnualInterestRate.ToString("N2")%</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Plazo</th>
                                <td>@Model.TermMonths meses</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="d-flex gap-3">
                <!-- CONFIRMAR ConfirmAssign -->
                <form asp-action="ConfirmAssign" asp-controller="Loans" asp-area="Admin" method="post" class="flex-fill">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100 py-2">
                        <i class="fas fa-check me-2"></i>Confirmar y asignar préstamo
                    </button>
                </form>

                <!-- CANCELAR CancelAssign -->
                <form asp-action="CancelAssign" asp-controller="Loans" asp-area="Admin" method="post" class="flex-fill">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary w-100 py-2">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
