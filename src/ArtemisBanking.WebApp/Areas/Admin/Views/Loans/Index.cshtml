@model IEnumerable<ArtemisBanking.WebApp.ViewModels.Admin.LoanListViewModel>
@{
    ViewData["Title"] = "Listado de Préstamos Activos";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0"><i class="fas fa-hand-holding-usd me-2 text-warning"></i> Cartera de Préstamos</h3>
        <a asp-action="Assign" class="btn btn-warning text-dark shadow-sm rounded-pill px-4 fw-medium">
            <i class="fas fa-file-signature me-2"></i> Asignar Préstamo
        </a>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="py-3 px-4 fw-semibold border-0">N° PRÉSTAMO</th>
                        <th class="py-3 border-0">CLIENTE DEUDOR</th>
                        <th class="py-3 border-0 text-center">TASA MENSUAL</th>
                        <th class="py-3 border-0 text-end">MONTO ORIGINAL</th>
                        <th class="py-3 border-0 text-end">RESTANTE</th>
                        <th class="py-3 border-0 text-center">MESES</th>
                        <th class="py-3 px-4 border-0 text-center">ESTADO</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var loan in Model)
                    {
                        var percentagePaid = loan.Amount > 0 ? ((loan.Amount - loan.RemainingDebt) / loan.Amount) * 100 : 0;
                        <tr>
                            <td class="px-4 fw-bold">
                                <span class="badge bg-secondary bg-opacity-10 text-dark px-3 py-2 rounded-pill font-monospace">
                                    @loan.LoanNumber
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@loan.ClientName</div>
                                <small class="text-muted">Desembolso: @loan.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="text-center fw-medium text-dark">
                                @((loan.AnnualInterestRate / 12).ToString("0.00"))%
                            </td>
                            <td class="text-end text-muted text-decoration-line-through">
                                @loan.Amount.ToString("N2")
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @loan.RemainingDebt.ToString("N2")
                                <div class="progress mt-1" style="height: 4px;" title="@Math.Round(percentagePaid,1)% Pagado">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @percentagePaid%;"></div>
                                </div>
                            </td>
                            <td class="text-center text-dark">
                                @loan.TermMonths
                            </td>
                            <td class="text-center px-4">
                                @if (loan.RemainingDebt <= 0 && loan.Amount > 0) {
                                    <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3 py-1">PAGADO</span>
                                } else if (loan.IsActive) {
                                    <span class="badge bg-warning bg-opacity-25 text-warning rounded-pill px-3 py-1 text-dark">AL DÍA</span>
                                } else {
                                    <span class="badge bg-danger bg-opacity-25 text-danger rounded-pill px-3 py-1">EN MORA</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-2x mb-2 text-light"></i><br>
                                Carter de préstamos vacía...
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
