@model IEnumerable<ArtemisBanking.WebApp.ViewModels.Admin.LoanListViewModel>
@{
    ViewData["Title"] = "Listado de Préstamos Activos";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages  ?? 1);
    var searchCedula = ViewBag.SearchCedula as string ?? "";
    var filterState  = ViewBag.FilterState  as string ?? "";
}

<div class="container-fluid py-3">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0">
            <i class="fas fa-hand-holding-usd me-2 text-warning"></i> Cartera de Préstamos
        </h3>
        <a asp-action="Assign" class="btn btn-warning text-dark shadow-sm rounded-pill px-4 fw-medium">
            <i class="fas fa-file-signature me-2"></i> Asignar Préstamo
        </a>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-3">
                
                <!-- Búsqueda por Cédula -->
                <div class="input-group w-auto">
                    <span class="input-group-text bg-light border-light text-muted rounded-start-3"><i class="fas fa-id-card"></i></span>
                    <input type="text" name="searchCedula" value="@ViewBag.SearchCedula" class="form-control bg-light border-light" placeholder="Buscar por Cédula..." />
                </div>

                <!-- Filtro por Estado -->
                <label class="fw-medium text-muted mb-0 ms-2">Estado:</label>
                <select name="filterState" class="form-select w-auto rounded-3 border-light bg-light" onchange="this.form.submit()">
                    <option value="">TODOS</option>
                    @if (ViewBag.FilterState == "Pagado") {
                        <option value="Pagado" selected>Pagado</option>
                    } else {
                        <option value="Pagado">Pagado</option>
                    }

                    @if (ViewBag.FilterState == "AlDia") {
                        <option value="AlDia" selected>Al Día</option>
                    } else {
                        <option value="AlDia">Al Día</option>
                    }

                    @if (ViewBag.FilterState == "EnMora") {
                        <option value="EnMora" selected>En Mora</option>
                    } else {
                        <option value="EnMora">En Mora</option>
                    }
                </select>
                
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 ms-auto">Aplicar</button>
                <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3">Limpiar</a>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="py-3 px-4 fw-semibold border-0">N° PRÉSTAMO</th>
                        <th class="py-3 border-0">CLIENTE DEUDOR</th>
                        <th class="py-3 border-0 text-center">TASA MENSUAL</th>
                        <th class="py-3 border-0 text-end">MONTO ORIGINAL</th>
                        <th class="py-3 border-0 text-end">RESTANTE</th>
                        <th class="py-3 border-0 text-center">MESES</th>
                        <th class="py-3 px-4 border-0 text-center">ESTADO</th>
                        <th class="py-3 px-4 border-0 text-center">ACCIONES</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var loan in Model)
                    {
                        var percentagePaid = loan.Amount > 0
                            ? ((loan.Amount - loan.RemainingDebt) / loan.Amount) * 100
                            : 0;
                        <tr>
                            <td class="px-4 fw-bold">
                                <span class="badge bg-secondary bg-opacity-10 text-dark px-3 py-2 rounded-pill font-monospace">
                                    @loan.LoanNumber
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@loan.ClientName</div>
                                <small class="text-muted">Desembolso: @loan.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td class="text-center fw-medium text-dark">
                                @((loan.AnnualInterestRate / 12).ToString("0.00"))%
                            </td>
                            <td class="text-end text-muted text-decoration-line-through">
                                @loan.Amount.ToString("N2")
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @loan.RemainingDebt.ToString("N2")
                                <div class="progress mt-1" style="height:4px;" title="@Math.Round(percentagePaid,1)% Pagado">
                                    <div class="progress-bar bg-success" style="width:@percentagePaid%;"></div>
                                </div>
                            </td>
                            <td class="text-center text-dark">@loan.TermMonths</td>
                            <td class="text-center px-4">
                                @if (loan.RemainingDebt <= 0 && loan.Amount > 0)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3 py-1">PAGADO</span>
                                }
                                else if (loan.IsActive)
                                {
                                    <span class="badge bg-warning bg-opacity-25 rounded-pill px-3 py-1 text-dark">AL DÍA</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-25 text-danger rounded-pill px-3 py-1">EN MORA</span>
                                }
                            </td>
                            <td class="text-center px-4">
                                @if (loan.IsActive && loan.RemainingDebt > 0)
                                {
                                    <a asp-action="EditRate" asp-route-id="@loan.Id"
                                       class="btn btn-sm btn-outline-warning rounded-pill px-3"
                                       title="Editar tasa de interés">
                                        <i class="fas fa-percentage me-1"></i>Editar Tasa
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-2x mb-2 text-light"></i><br>
                                Cartera de préstamos vacía...
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 px-4">
                <nav aria-label="Paginación préstamos">
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill me-1" asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchCedula="@searchCedula"
                               asp-route-filterState="@filterState">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link mx-1 rounded-pill" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchCedula="@searchCedula"
                                   asp-route-filterState="@filterState">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill ms-1" asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchCedula="@searchCedula"
                               asp-route-filterState="@filterState">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <p class="text-center text-muted small mt-2 mb-0">Página @currentPage de @totalPages</p>
            </div>
        }
    </div>
</div>
