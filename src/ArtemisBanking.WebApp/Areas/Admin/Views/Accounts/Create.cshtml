@model ArtemisBanking.WebApp.ViewModels.Admin.CreateAccountViewModel
@{
    ViewData["Title"] = "Abrir Cuenta de Ahorros Libreta";
}

<div class="row justify-content-center py-4">
    <div class="col-xl-6 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary bg-opacity-10 border-0 p-4">
                <h4 class="fw-bold text-primary mb-0"><i class="fas fa-plus-circle me-2"></i> Nueva Cuenta Secundaria</h4>
                <p class="text-muted mb-0 small">Emisión de libreta secundaria para clientes. Número de 9 dígitos generado con RandomNumberGenerator.</p>
            </div>
            
            <form asp-action="Create" method="post" class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="ClientId" class="form-label fw-bold text-dark">Cliente Titular</label>
                    <select asp-for="ClientId" asp-items="Model.Clients" class="form-select form-select-lg bg-light border-0">
                        <option value="">-- Seleccione un Cliente activo --</option>
                    </select>
                    <span asp-validation-for="ClientId" class="text-danger small"></span>
                </div>

                <!-- Info Box -->
                <div class="alert alert-light border d-flex align-items-center mb-4 rounded-3 p-3">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                        <i class="fas fa-check"></i>
                    </div>
                    <div>
                        <strong class="text-dark">Número de Cuenta Automático</strong><br>
                        <small class="text-muted">El sistema se encargará de crear una cadena de 9 dígitos irrepetible.</small>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-light px-4 rounded-pill fw-medium">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5 rounded-pill fw-medium shadow-sm">
                        <i class="fas fa-folder-plus me-2"></i> Crear Cuenta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
