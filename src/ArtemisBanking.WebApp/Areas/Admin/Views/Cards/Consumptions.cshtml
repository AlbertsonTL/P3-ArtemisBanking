@model ArtemisBanking.WebApp.ViewModels.Admin.CardConsumptionViewModel
@{
    ViewData["Title"] = "Historial de Consumos";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Tarjetas</a></li>
                <li class="breadcrumb-item active">Consumos</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark mb-0">
            <i class="fas fa-receipt me-2 text-primary"></i> Historial de Consumos
        </h3>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="fas fa-credit-card fa-2x"></i>
                    </div>
                    <div>
                        <div class="small opacity-75">Tarjeta Finalizada en</div>
                        <div class="h4 fw-bold mb-0">**** **** **** @Model.CardNumber.Substring(12)</div>
                        <div class="small opacity-75">Titular: @Model.ClientName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="py-3 px-4 fw-semibold border-0">FECHA</th>
                        <th class="py-3 border-0">ESTABLECIMIENTO / COMERCIO</th>
                        <th class="py-3 border-0 text-end">MONTO (RD$)</th>
                        <th class="py-3 px-4 border-0 text-center">ESTADO</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var c in Model.Consumptions)
                    {
                        <tr>
                            <td class="px-4">
                                <div class="fw-medium text-dark">@c.Date.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">@c.Date.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    <i class="fas fa-store me-1 text-muted"></i> @c.CommerceName
                                </div>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                RD$ @c.Amount.ToString("N2")
                            </td>
                            <td class="text-center px-4">
                                @if (c.Status == ArtemisBanking.Domain.Enums.ConsumptionStatus.Approved)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-medium border border-success border-opacity-25">
                                        <i class="fas fa-check-circle me-1"></i> Aprobado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-medium border border-danger border-opacity-25">
                                        <i class="fas fa-times-circle me-1"></i> Rechazado
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Consumptions.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-ghost fa-3x mb-3 text-light"></i><br>
                                No hay consumos registrados para esta tarjeta todavía.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-light rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Volver al Listado
        </a>
    </div>
</div>
