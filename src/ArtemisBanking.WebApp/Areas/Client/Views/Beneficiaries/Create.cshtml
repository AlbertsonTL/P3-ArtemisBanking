@model AddBeneficiaryViewModel
@{
    ViewData["Title"] = "Agregar Beneficiario";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="mb-4">
            <a asp-action="Index" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver al listado
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                        <i class="fas fa-user-plus fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-slate-800">Nuevo Beneficiario</h3>
                </div>

                <form asp-action="Create" method="post" id="beneficiaryForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label class="form-label text-slate-700 fw-semibold small">Número de Cuenta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-slate-400">
                                <i class="fas fa-hashtag"></i>
                            </span>
                            <!-- Campo visual con auto-guionado -->
                            <input type="text"
                                   id="AccountNumberDisplay"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Ej. 123-456789-0"
                                   maxlength="11"
                                   autocomplete="off" />
                            <!-- Campo oculto que envía solo los 9 dígitos reales al backend -->
                            <input type="hidden" id="AccountNumber" name="AccountNumber" />
                        </div>
                        <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Alias" class="form-label text-slate-700 fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-slate-400">
                                <i class="fas fa-tag"></i>
                            </span>
                            <input asp-for="Alias" class="form-control border-start-0 ps-0" placeholder="Ej. Mi Madre, Mi Ahorro" />
                        </div>
                        <span asp-validation-for="Alias" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm">
                        Confirmar y Agregar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const displayInput = document.getElementById('AccountNumberDisplay');
        const hiddenInput = document.getElementById('AccountNumber');

        displayInput.addEventListener('input', function (e) {
            // Tomar solo los números, máximo 9 dígitos
            let digits = e.target.value.replace(/\D/g, '').substring(0, 9);

            // Formatear con guiones: XXX-XXXXX-X
            let formatted = '';
            if (digits.length > 0) formatted += digits.substring(0, 3);
            if (digits.length > 3) formatted += '-' + digits.substring(3, 8);
            if (digits.length > 8) formatted += '-' + digits.substring(8, 9);

            e.target.value = formatted;

            // Sincronizar el campo oculto con solo los dígitos
            hiddenInput.value = digits;
        });

        // Antes de enviar el formulario, asegurar sincronización
        document.getElementById('beneficiaryForm').addEventListener('submit', function () {
            let digits = displayInput.value.replace(/\D/g, '').substring(0, 9);
            hiddenInput.value = digits;
        });
    </script>
}
