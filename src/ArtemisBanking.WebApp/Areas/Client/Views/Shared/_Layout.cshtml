@using ArtemisBanking.Domain.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }
        
        #sidebar {
            min-width: 280px;
            max-width: 280px;
            min-height: 100vh;
            background: #1e293b;
            color: #f8fafc;
            transition: all 0.3s;
            z-index: 1000;
        }

        #sidebar .sidebar-header {
            padding: 2rem 1.5rem;
            background: #0f172a;
        }

        #sidebar ul.components {
            padding: 1.5rem 0;
        }

        #sidebar ul li a {
            padding: 0.8rem 1.5rem;
            display: flex;
            align-items: center;
            color: #94a3b8;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
            margin: 0.2rem 0.8rem;
            border-radius: 0.5rem;
        }
        
        #sidebar ul li a i {
            margin-right: 12px;
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
        }

        #sidebar ul li a:hover {
            color: #fff;
            background: #334155;
        }

        #sidebar ul li.active > a {
            color: #fff;
            background: #3b82f6;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.5);
        }

        .main-content {
            width: 100%;
            max-height: 100vh;
            overflow-y: auto;
            flex-grow: 1;
        }
        
        .top-navbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid #e2e8f0;
            z-index: 999;
        }

        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        .btn-primary {
            background-color: #3b82f6;
            border-color: #3b82f6;
            padding: 0.6rem 1.2rem;
            border-radius: 0.6rem;
            font-weight: 600;
        }

        .btn-primary:hover {
            background-color: #2563eb;
            border-color: #2563eb;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="d-flex w-100">
        <!-- Sidebar -->
        <nav id="sidebar" class="d-none d-md-block">
            <div class="sidebar-header d-flex align-items-center">
                <i class="fas fa-gem text-primary fs-3 me-2"></i>
                <h4 class="mb-0 fw-bold tracking-tight">Artemis</h4>
            </div>

            <ul class="list-unstyled components">
                <p class="text-slate-400 text-uppercase fw-bold px-4 mb-3" style="font-size: 0.7rem; letter-spacing: 0.05em; opacity: 0.6;">Menú Principal</p>
                
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-th-large"></i> Dashboard
                    </a>
                </li>
                
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Beneficiaries" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Beneficiaries" asp-action="Index">
                        <i class="fas fa-users"></i> Beneficiarios
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Transactions" asp-action="Index">
                        <i class="fas fa-paper-plane"></i> Transacciones
                    </a>
                </li>

                <li class="mt-4">
                    <p class="text-slate-400 text-uppercase fw-bold px-4 mb-3" style="font-size: 0.7rem; letter-spacing: 0.05em; opacity: 0.6;">Configuración</p>
                    <a href="#">
                        <i class="fas fa-user-cog"></i> Mi Perfil
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div class="main-content d-flex flex-column">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg top-navbar py-3 px-4 sticky-top">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-link text-slate-600 d-md-none me-3">
                        <i class="fas fa-bars"></i>
                    </button>
                    
                    <h5 class="mb-0 fw-bold text-slate-800 d-none d-sm-block">@ViewData["Title"]</h5>
                     
                    <div class="ms-auto d-flex align-items-center">
                        <div class="dropdown">
                            <button class="btn btn-link dropdown-toggle text-decoration-none text-slate-700 d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    @(User.Identity?.Name?[0].ToString().ToUpper() ?? "U")
                                </div>
                                <span class="fw-semibold d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item py-2 px-3" href="#"><i class="fas fa-user me-2 opacity-50"></i> Mi Perfil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a asp-area="" asp-controller="Account" asp-action="Logout" class="dropdown-item py-2 px-3 text-danger">
                                        <i class="fas fa-sign-out-alt me-2 opacity-50"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Body -->
            <main class="flex-grow-1 p-4">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 24px; height: 24px;">
                                    <i class="fas fa-check" style="font-size: 0.7rem;"></i>
                                </div>
                                <div>@TempData["Success"]</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 24px; height: 24px;">
                                    <i class="fas fa-exclamation" style="font-size: 0.7rem;"></i>
                                </div>
                                <div>@TempData["Error"]</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @RenderBody()
                </div>
            </main>
            
            <footer class="mt-auto px-4 py-3 bg-white border-top">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <span class="text-muted small">© @DateTime.Now.Year Artemis Banking Group</span>
                    <span class="text-muted small">v1.0.0</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
