@using ArtemisBanking.Domain.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking</title>
    <script>try { if (localStorage.getItem('artemis-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (error) { }</script>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="d-flex w-100">
        <!-- Sidebar -->
        <nav id="sidebar" class="d-none d-md-block">
            <div class="sidebar-header d-flex align-items-center">
                <i class="fas fa-gem text-primary fs-3 me-2"></i>
                <h4 class="mb-0 fw-bold text-dark tracking-tight">Artemis</h4>
            </div>

            <ul class="list-unstyled components">
                <p class="text-slate-400 text-uppercase fw-bold px-4 mb-3 section-label">Menú Principal</p>
                
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-th-large"></i> Dashboard
                    </a>
                </li>
                
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Beneficiaries" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Beneficiaries" asp-action="Index">
                        <i class="fas fa-users"></i> Beneficiarios
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <a asp-area="Client" asp-controller="Transactions" asp-action="Index">
                        <i class="fas fa-paper-plane"></i> Transacciones
                    </a>
                </li>

                    <li class="mt-4">
                        <p class="text-slate-400 text-uppercase fw-bold px-4 mb-3 section-label">Configuración</p>
                        <a asp-area="Client" asp-controller="Profile" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profile" ? "active" : "")">
                            <i class="fas fa-user-cog"></i> Mi Perfil
                        </a>
                    </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div class="main-content d-flex flex-column">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg top-navbar py-3 px-4 sticky-top">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-link text-slate-600 d-md-none me-3">
                        <i class="fas fa-bars"></i>
                    </button>
                    
                    <h5 class="mb-0 fw-bold text-slate-800 d-none d-sm-block">@ViewData["Title"]</h5>
                     
                    <div class="ms-auto d-flex align-items-center">
                        <button type="button" class="theme-toggle me-3" data-theme-toggle aria-label="Cambiar a modo oscuro" aria-pressed="false">
                            <i data-theme-icon class="fas fa-moon" aria-hidden="true"></i>
                            <span data-theme-label>Modo oscuro</span>
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-link dropdown-toggle text-decoration-none text-slate-700 d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 avatar-sm">
                                    @(User.Identity?.Name?[0].ToString().ToUpper() ?? "U")
                                </div>
                                <span class="fw-semibold d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item py-2 px-3" asp-area="Client" asp-controller="Profile" asp-action="Index"><i class="fas fa-user me-2 opacity-50"></i> Mi Perfil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a asp-area="" asp-controller="Account" asp-action="Logout" class="dropdown-item py-2 px-3 text-danger">
                                        <i class="fas fa-sign-out-alt me-2 opacity-50"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Body -->
            <main class="flex-grow-1 p-4">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-3 alert-icon">
                                    <i class="fas fa-check text-xxs"></i>
                                </div>
                                <div>@TempData["Success"]</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3 alert-icon">
                                    <i class="fas fa-exclamation text-xxs"></i>
                                </div>
                                <div>@TempData["Error"]</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    @RenderBody()
                </div>
            </main>
            
            <footer class="mt-auto px-4 py-3 bg-white border-top">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <span class="text-muted small">© @DateTime.Now.Year Artemis Banking Group</span>
                    <span class="text-muted small">v1.0.0</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
