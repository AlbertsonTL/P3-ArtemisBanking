@model List<ArtemisBanking.Domain.Entities.AmortizationEntry>
@{
    ViewData["Title"] = "Tabla de Amortización";
}

<div class="mb-4">
    <a asp-action="Index" class="text-slate-500 text-decoration-none small fw-bold">
        <i class="fas fa-arrow-left me-1"></i> Volver al dashboard
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-dark p-4 h-100">
            <p class="small text-uppercase fw-bold opacity-75 mb-1">Préstamo Activo</p>
            <h4 class="fw-bold font-monospace"># @ViewBag.LoanNumber</h4>
            <div class="mt-auto">
                <p class="small text-uppercase fw-bold opacity-75 mb-0">Monto del Préstamo</p>
                <h2 class="fw-bold mb-0">RD$ @ViewBag.Amount.ToString("N2")</h2>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 px-4 border-bottom-0">
        <h5 class="fw-bold text-slate-800 mb-0">Calendario de Pagos</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-slate-50">
                <tr>
                    <th class="ps-4 py-3 text-slate-500 fw-bold small text-uppercase">Cuota</th>
                    <th class="py-3 text-slate-500 fw-bold small text-uppercase">Fecha de Pago</th>
                    <th class="py-3 text-slate-500 fw-bold small text-uppercase">Monto Cuota</th>
                    <th class="py-3 text-slate-500 fw-bold small text-uppercase">Estado</th>
                    <th class="pe-4 py-3 text-end text-slate-500 fw-bold small text-uppercase">Fecha Efectiva</th>
                </tr>
            </thead>
            <tbody>
                @{ int count = 1; }
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-bold text-slate-400">#@count</td>
                        <td class="py-3 text-slate-700 fw-medium">@entry.PaymentDate.ToString("dd/MM/yyyy")</td>
                        <td class="py-3 fw-bold text-slate-800">RD$ @entry.QuotaAmount.ToString("N2")</td>
                        <td class="py-3">
                            @if (entry.IsPaid)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">PAGADO</span>
                            }
                            else if (entry.IsLate)
                            {
                                <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">VENCIDO</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">PENDIENTE</span>
                            }
                        </td>
                        <td class="pe-4 py-3 text-end text-muted small">
                            @(entry.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                    </tr>
                    count++;
                }
            </tbody>
        </table>
    </div>
</div>
