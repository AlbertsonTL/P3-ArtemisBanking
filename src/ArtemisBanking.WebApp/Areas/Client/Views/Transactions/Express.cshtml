@model ExpressTransferViewModel
@{
    ViewData["Title"] = "Transferencia Express";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver al menú
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                <h4 class="fw-bold text-slate-800 mb-0">Transferencia Express</h4>
                <p class="text-muted small">Envía dinero a cualquier cuenta de Artemis Banking de forma inmediata.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Express" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="SourceAccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <select asp-for="SourceAccountNumber" asp-items="Model.MyAccounts" class="form-select">
                            <option value="">-- Seleccione origen --</option>
                        </select>
                        <span asp-validation-for="SourceAccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DestinationAccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <div class="input-group">
                             <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-search"></i></span>
                             <input asp-for="DestinationAccountNumber" class="form-control border-start-0 ps-0" placeholder="Número de cuenta (9 dígitos)" maxlength="9" />
                        </div>
                        <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
                        <div class="form-text small">Asegúrese de que el número sea correcto.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold small text-slate-600"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">RD$</span>
                            <input asp-for="Amount" class="form-control border-start-0 ps-0 fw-bold" placeholder="0.00" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold rounded-3 shadow-sm">
                        <i class="fas fa-paper-plane me-2"></i> Enviar Dinero
                    </button>
                    <p class="text-center mt-3 text-muted small">
                        <i class="fas fa-shield-alt text-success me-1"></i> Transacción protegida por Artemis Banking
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
