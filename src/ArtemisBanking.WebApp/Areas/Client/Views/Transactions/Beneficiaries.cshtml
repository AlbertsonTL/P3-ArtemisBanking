@model BeneficiaryTransferViewModel
@{
    ViewData["Title"] = "Transferencia a Beneficiario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver al menú
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                <h4 class="fw-bold text-slate-800 mb-0">Mis Contactos</h4>
                <p class="text-muted small">Transfiere a tus beneficiarios registrados de forma rápida.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Beneficiaries" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="SourceAccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <select asp-for="SourceAccountNumber" asp-items="Model.MyAccounts" class="form-select">
                            <option value="">-- Seleccione origen --</option>
                        </select>
                        <span asp-validation-for="SourceAccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DestinationAccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <select asp-for="DestinationAccountNumber" asp-items="Model.Beneficiaries" class="form-select">
                            <option value="">-- Seleccione beneficiario --</option>
                        </select>
                        <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
                        <div class="mt-2 text-end">
                            <a asp-controller="Beneficiaries" asp-action="Create" class="small text-primary text-decoration-none fw-bold">
                                + Agregar nuevo beneficiario
                            </a>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold small text-slate-600"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">RD$</span>
                            <input asp-for="Amount" class="form-control border-start-0 ps-0 fw-bold" placeholder="0.00" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-info text-white w-100 py-3 fw-bold rounded-3 shadow-sm">
                        Enviar a Beneficiario
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
