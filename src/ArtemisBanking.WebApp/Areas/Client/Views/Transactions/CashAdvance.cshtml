@model CashAdvanceViewModel
@{
    ViewData["Title"] = "Avance de Efectivo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-4">
            <a asp-action="Index" class="text-slate-500 text-decoration-none small fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Volver al menú
            </a>
        </div>

        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 text-center">
                 <div class="bg-dark-subtle text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    <i class="fas fa-money-bill-wave fs-4"></i>
                </div>
                <h4 class="fw-bold text-slate-800 mb-0">Avance de Efectivo</h4>
                <p class="text-muted small">Retira dinero de tu tarjeta hacia tu cuenta de ahorros.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="CashAdvance" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="CreditCardId" class="form-label fw-bold small text-slate-600"></label>
                        <select asp-for="CreditCardId" asp-items="Model.MyCards" class="form-select">
                            <option value="">-- Seleccione tarjeta origen --</option>
                        </select>
                        <span asp-validation-for="CreditCardId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DestinationAccountNumber" class="form-label fw-bold small text-slate-600"></label>
                        <select asp-for="DestinationAccountNumber" asp-items="Model.MyAccounts" class="form-select">
                            <option value="">-- Seleccione cuenta destino --</option>
                        </select>
                        <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="text-center my-3 text-slate-200">
                        <i class="fas fa-random fs-5"></i>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold small text-slate-600"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0">RD$</span>
                            <input asp-for="Amount" class="form-control border-start-0 ps-0 fw-bold" placeholder="0.00" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="alert alert-info border-0 mt-3 small p-2">
                            <i class="fas fa-percent me-2"></i> Esta transacción conlleva un cargo de **6.25% de interés** que se cargará a su tarjeta.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-3 shadow-sm">
                        Procesar Avance de Efectivo
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
