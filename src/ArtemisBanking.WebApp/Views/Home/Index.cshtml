@{
    ViewData["Title"] = "Bienvenido a Artemis Banking";
}

<div class="row min-vh-75 align-items-center">
    <div class="col-lg-6 mb-5 mb-lg-0">
        <h1 class="display-3 fw-bold mb-4">
            Tu Futuro <br />
            <span class="text-gradient">Financiero</span> <br />
            Empieza Aquí
        </h1>
        <p class="lead text-muted mb-5 pe-lg-5">
            Artemis Banking combina seguridad bancaria tradicional con tecnología de última generación para ofrecerte la mejor experiencia en banca digital.
        </p>
        <div class="d-flex gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Home" asp-action="Index" asp-area="@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Cajero") ? "Cashier" : "Client")" class="btn btn-primary btn-lg">
                    Ir a Mi Dashboard
                </a>
            }
            else
            {
                <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                    Comenzar Ahora
                </a>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="row g-4">
            <div class="col-6">
                <div class="card p-4 h-100 border-bottom border-4 border-info">
                    <div class="stat-icon bg-info bg-opacity-10 text-info">
                        <i class="fas fa-user-tie fs-4"></i>
                    </div>
                    <h5 class="fw-bold">Para Clientes</h5>
                    <p class="small text-muted">Gestiona tus ahorros, tarjetas y préstamos de forma fácil.</p>
                </div>
            </div>
            <div class="col-6">
                <div class="card p-4 h-100 border-bottom border-4 border-warning">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-cash-register fs-4"></i>
                    </div>
                    <h5 class="fw-bold">Módulo Cajero</h5>
                    <p class="small text-muted">Operaciones rápidas en ventanilla con seguridad garantizada.</p>
                </div>
            </div>
            <div class="col-6">
                <div class="card p-4 h-100 border-bottom border-4 border-dark">
                    <div class="stat-icon bg-dark bg-opacity-10 text-dark">
                        <i class="fas fa-shield-halved fs-4"></i>
                    </div>
                    <h5 class="fw-bold">Administración</h5>
                    <p class="small text-muted">Control total de usuarios, roles y auditoría del sistema.</p>
                </div>
            </div>
            <div class="col-6">
                <div class="card p-4 h-100 border-bottom border-4 border-success">
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fas fa-code fs-4"></i>
                    </div>
                    <h5 class="fw-bold">API Hermes</h5>
                    <p class="small text-muted">Integración segura para comercios con procesamiento real.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 pt-5 pb-5 text-center">
    <div class="col-md-4 mb-4">
        <div class="p-3">
            <i class="fas fa-lock fs-2 text-primary mb-3"></i>
            <h6>Seguridad Nivel Bancario</h6>
            <p class="small text-muted">Encriptación total y validaciones de rol en cada punto.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-3">
            <i class="fas fa-bolt fs-2 text-primary mb-3"></i>
            <h6>Optimización Extrema</h6>
            <p class="small text-muted">Consultas de base de datos ultrarrápidas y carga ligera.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-3">
            <i class="fas fa-microchip fs-2 text-primary mb-3"></i>
            <h6>Tecnología de Vanguardia</h6>
            <p class="small text-muted">Arquitectura moderna lista para escalar con tu negocio.</p>
        </div>
    </div>
</div>
