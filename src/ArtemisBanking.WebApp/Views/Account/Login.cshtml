@model ArtemisBanking.WebApp.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = "Iniciar Sesión"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Acceso Seguro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="auth-page">
    <div class="container d-flex justify-content-center px-3">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon"><i class="fas fa-university"></i></div>
                <h3 class="auth-title">Artemis Banking</h3>
                <p class="auth-subtitle mb-0">Plataforma de Operaciones Seguras</p>
            </div>

            <div class="auth-body">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success mb-4 d-flex align-items-start" role="alert">
                        <i class="fas fa-check-circle mt-1 me-3 fs-5"></i>
                        <div>@successMessage</div>
                    </div>
                }

                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="alert alert-danger mb-4 d-flex align-items-start" role="alert">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>@errorMessage</div>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass mb-4 d-flex align-items-start">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div class="mb-1">@error.ErrorMessage</div> }
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-floating mb-4">
                        <input asp-for="UserName" class="form-control" placeholder="Usuario" autocomplete="username" autofocus>
                        <label asp-for="UserName">Usuario</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Contraseña" autocomplete="current-password">
                        <label asp-for="Password">Contraseña</label>
                    </div>

                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                            <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
                        </div>
                        <a asp-action="ForgotPassword" class="auth-link small">¿Olvidaste tu clave?</a>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-submit d-flex align-items-center justify-content-center gap-2">
                            <span>Acceder al Sistema</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
