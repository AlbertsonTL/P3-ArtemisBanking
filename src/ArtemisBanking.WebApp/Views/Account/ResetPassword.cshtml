@model ArtemisBanking.WebApp.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Establecer Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="auth-page">
    <div class="container d-flex justify-content-center px-3">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3 class="auth-title">Nueva Contraseña</h3>
                <p class="auth-subtitle">Crea una clave fuerte y segura para proteger tu cuenta Artemis y reactivar tu acceso.</p>
            </div>

            <div class="auth-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass mb-4 d-flex align-items-start">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div class="mb-1">@e.ErrorMessage</div> }
                        </div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="UserId" type="hidden">
                    <input asp-for="Token"  type="hidden">
                    
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" type="password" placeholder="Nueva " autocomplete="new-password" autofocus oninput="evaluarSeguridad(this.value)">
                        <label asp-for="Password">Nueva Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <!-- Indicador visual rápido -->
                    <div class="security-indicator" title="Indicador de seguridad de contraseña">
                        <div class="security-level" id="secLevel"></div>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirmar" autocomplete="new-password">
                        <label asp-for="ConfirmPassword">Confirmar Nueva Contraseña</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <div class="d-grid mb-1">
                        <button type="submit" class="btn btn-submit d-flex align-items-center justify-content-center gap-2">
                            <span>Establecer Seguridad</span>
                            <i class="fas fa-unlock-alt"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function evaluarSeguridad(pwd) {
            let barra = document.getElementById('secLevel');
            let nivel = 0;
            if (pwd.length > 5) nivel += 25;
            if (pwd.length >= 8) nivel += 25;
            if (/[A-Z]/.test(pwd)) nivel += 25;
            if (/[0-9\W]/.test(pwd)) nivel += 25;

            barra.style.width = nivel + '%';
            if (nivel <= 25) barra.style.background = '#ef4444'; // rojo
            else if (nivel <= 75) barra.style.background = '#eab308'; // amarillo
            else barra.style.background = '#22c55e'; // verde
        }
    </script>
</body>
</html>