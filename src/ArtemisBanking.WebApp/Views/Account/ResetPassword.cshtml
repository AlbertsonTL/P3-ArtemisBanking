@model ArtemisBanking.WebApp.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Nueva contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background:#1a3c5e; min-height:100vh;
               display:flex; align-items:center; justify-content:center; }
        .card { border:none; border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,.3); }
        .card-header { background:#c0392b; color:white;
                       border-radius:12px 12px 0 0 !important; padding:24px; text-align:center; }
        .btn-danger { background:#c0392b; border-color:#c0392b; }
    </style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header"><h4 class="mb-0">🔑 Nueva contraseña</h4></div>
        <div class="card-body p-4">

          @if (!ViewData.ModelState.IsValid)
          {
            <div class="alert alert-danger">
              @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
              { <div>@e.ErrorMessage</div> }
            </div>
          }

          <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="UserId" type="hidden">
            <input asp-for="Token"  type="hidden">

            <div class="mb-3">
              <label asp-for="Password" class="form-label fw-bold"></label>
              <input asp-for="Password" class="form-control form-control-lg" autofocus>
              <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
              <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
              <input asp-for="ConfirmPassword" class="form-control form-control-lg">
              <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-danger btn-lg">Cambiar contraseña</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>