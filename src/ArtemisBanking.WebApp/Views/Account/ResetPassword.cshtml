@model ArtemisBanking.WebApp.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Establecer Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
        
        body { 
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #090e17 0%, #1a2a40 100%);
            min-height: 100vh;
            display: flex; 
            align-items: center; 
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        /* Ambient floating orbs (Red hue for alert/reset context) */
        .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.4; z-index: 0; animation: float 10s infinite ease-in-out; }
        .orb-1 { width: 400px; height: 400px; background: rgba(239, 68, 68, 0.4); top: -100px; left: -100px; }
        .orb-2 { width: 300px; height: 300px; background: rgba(220, 38, 38, 0.3); bottom: -50px; right: -50px; animation-delay: -5s; }

        @@keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 480px;
            z-index: 1;
            overflow: hidden;
            transform: translateY(20px);
            opacity: 0;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes slideUp {
            to { transform: translateY(0); opacity: 1; }
        }

        .auth-header {
            padding: 40px 40px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .auth-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: white;
            margin: 0 auto 20px;
            box-shadow: 0 10px 25px rgba(239, 68, 68, 0.4);
            transform: rotate(-10deg);
            transition: all 0.3s ease;
        }

        .auth-card:hover .auth-icon {
            transform: rotate(0deg) scale(1.05);
        }

        .auth-title { color: #f8fafc; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 10px; }
        .auth-subtitle { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; }

        .auth-body { padding: 30px 40px 40px; }

        .form-floating { margin-bottom: 25px; position: relative; }
        .form-floating > .form-control {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255,255,255,0.1);
            color: #f8fafc;
            border-radius: 12px;
            padding-left: 20px;
            height: 60px;
            transition: all 0.3s ease;
        }
        
        .form-floating > .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.15);
        }

        .form-floating > label { color: #64748b; padding-left: 20px; }
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #ef4444;
            transform: scale(0.85) translateY(-0.75rem) translateX(0.15rem);
        }

        .security-indicator {
            height: 4px; border-radius: 4px; background: rgba(255,255,255,0.1); width: 100%; margin: -10px 0 25px;
            overflow: hidden; position: relative;
        }
        .security-level { height: 100%; width: 0%; background: #ef4444; transition: width 0.3s ease, background 0.3s; }

        .btn-submit {
            background: linear-gradient(to right, #dc2626, #ef4444);
            border: none;
            color: white;
            border-radius: 12px;
            height: 56px;
            font-weight: 600;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            margin-top: 10px;
        }

        .btn-submit::after {
            content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
            transform: skewX(-20deg); transition: all 0.5s ease;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.4);
            color: white;
        }
        
        .btn-submit:hover::after { left: 150%; }

        .alert-glass {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            border-radius: 12px;
            padding: 15px 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container d-flex justify-content-center">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3 class="auth-title">Nueva Contraseña</h3>
                <p class="auth-subtitle">Crea una clave fuerte y segura para proteger tu cuenta Artemis y reactivar tu acceso.</p>
            </div>

            <div class="auth-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass mb-4 d-flex align-items-start">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div class="mb-1">@e.ErrorMessage</div> }
                        </div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="UserId" type="hidden">
                    <input asp-for="Token"  type="hidden">
                    
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" type="password" placeholder="Clave" autocomplete="new-password" autofocus oninput="evaluarSeguridad(this.value)">
                        <label asp-for="Password">Ingresar Nueva Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <!-- Indicador visual rápido -->
                    <div class="security-indicator" title="Indicador de seguridad de contraseña">
                        <div class="security-level" id="secLevel"></div>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirmar" autocomplete="new-password">
                        <label asp-for="ConfirmPassword">Confirmar Nueva Contraseña</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <div class="d-grid mb-1">
                        <button type="submit" class="btn btn-submit d-flex align-items-center justify-content-center gap-2">
                            <span>Establecer Seguridad</span>
                            <i class="fas fa-unlock-alt"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function evaluarSeguridad(pwd) {
            let barra = document.getElementById('secLevel');
            let nivel = 0;
            if (pwd.length > 5) nivel += 25;
            if (pwd.length >= 8) nivel += 25;
            if (/[A-Z]/.test(pwd)) nivel += 25;
            if (/[0-9\W]/.test(pwd)) nivel += 25;

            barra.style.width = nivel + '%';
            if (nivel <= 25) barra.style.background = '#ef4444'; // rojo
            else if (nivel <= 75) barra.style.background = '#eab308'; // amarillo
            else barra.style.background = '#22c55e'; // verde
        }
    </script>
</body>
</html>