@{ ViewData["Title"] = "Acceso Denegado"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Acceso Denegado — Artemis Banking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="auth-page">
    <div class="container d-flex justify-content-center px-3">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon auth-icon--warning"><i class="fas fa-ban"></i></div>
                <h3 class="auth-title">Acceso Denegado</h3>
                <p class="auth-subtitle mb-0">No tiene permiso para acceder a esta sección.</p>
            </div>

            <div class="auth-body text-center">
                <p class="auth-copy mb-4">Solo puede acceder a las funcionalidades de su rol asignado.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Home" asp-action="Index" asp-area="Admin" class="btn btn-submit d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-arrow-left"></i> Volver a mi panel
                    </a>
                }
                else if (User.IsInRole("Cajero"))
                {
                    <a asp-controller="Home" asp-action="Index" asp-area="Cajero" class="btn btn-submit d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-arrow-left"></i> Volver a mi panel
                    </a>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <a asp-controller="Home" asp-action="Index" asp-area="Cliente" class="btn btn-submit d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-arrow-left"></i> Volver a mi panel
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-submit d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="fas fa-arrow-left"></i> Ir al Login
                    </a>
                }
            </div>
        </div>
    </div>
</body>
</html>
