@{ ViewData["Title"] = "Acceso Denegado"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Acceso Denegado — Artemis Banking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body class="access-denied-page">
<div class="card access-denied-card">
    <div class="access-denied-icon">🚫</div>
    <h2 class="text-danger fw-bold">Acceso Denegado</h2>
    <p class="text-muted mt-3">
        No tiene permiso para acceder a esta sección.
        Solo puede acceder a las funcionalidades de su rol asignado.
    </p>
    <hr>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Home" asp-action="Index" asp-area="Admin"
           class="btn btn-primary mt-2">← Volver a mi panel</a>
    }
    else if (User.IsInRole("Cajero"))
    {
        <a asp-controller="Home" asp-action="Index" asp-area="Cajero"
           class="btn btn-primary mt-2">← Volver a mi panel</a>
    }
    else if (User.IsInRole("Cliente"))
    {
        <a asp-controller="Home" asp-action="Index" asp-area="Cliente"
           class="btn btn-primary mt-2">← Volver a mi panel</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login"
           class="btn btn-secondary mt-2">← Ir al Login</a>
    }
</div>
</body>
</html>