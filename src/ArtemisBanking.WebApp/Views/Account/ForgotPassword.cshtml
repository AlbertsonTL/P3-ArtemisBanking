@model ArtemisBanking.WebApp.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Olvidé mi contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Recuperación de Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="auth-page">
    <div class="container d-flex justify-content-center px-3">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <h3 class="auth-title">Recuperar Acceso</h3>
                <p class="auth-subtitle">Ingresa tu correo electrónico y enviaremos un enlace seguro a tu bandeja para restablecer tu cuenta.</p>
            </div>

            <div class="auth-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass mb-4 d-flex align-items-start">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div class="mb-1">@e.ErrorMessage</div> }
                        </div>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Email" type="email" class="form-control" placeholder="Correo Electrónico" autocomplete="email" autofocus>
                        <label asp-for="Email">Correo Electrónico</label>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-submit d-flex align-items-center justify-content-center gap-2">
                            <span>Enviar Enlace Seguro</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>

                    <div class="text-center mt-2">
                        <a asp-action="Login" class="back-link">
                            <i class="fas fa-chevron-left"></i> Volver a inicio de sesión
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>