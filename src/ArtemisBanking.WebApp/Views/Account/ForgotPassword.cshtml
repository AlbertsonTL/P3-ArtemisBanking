@model ArtemisBanking.WebApp.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Olvidé mi contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Restablecer contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background:#1a3c5e; min-height:100vh;
               display:flex; align-items:center; justify-content:center; }
        .card { border:none; border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,.3); }
        .card-header { background:#1a3c5e; color:white;
                       border-radius:12px 12px 0 0 !important; padding:24px; text-align:center; }
        .btn-primary { background:#1a3c5e; border-color:#1a3c5e; }
    </style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header"><h4 class="mb-0">🔐 Restablecer contraseña</h4></div>
        <div class="card-body p-4">
          <p class="text-muted">Ingresa tu nombre de usuario y te enviaremos un enlace.</p>

          @if (!ViewData.ModelState.IsValid)
          {
            <div class="alert alert-danger">
              @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
              { <div>@e.ErrorMessage</div> }
            </div>
          }

          <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label asp-for="UserName" class="form-label fw-bold"></label>
              <input asp-for="UserName" class="form-control form-control-lg" autofocus>
              <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary btn-lg">Enviar enlace</button>
            </div>
            <div class="text-center">
              <a asp-action="Login" class="text-decoration-none">← Volver al login</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>