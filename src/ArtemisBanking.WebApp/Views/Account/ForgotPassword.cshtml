@model ArtemisBanking.WebApp.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Olvidé mi contraseña"; Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Artemis Banking — Recuperación de Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');
        
        body { 
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #090e17 0%, #1a2a40 100%);
            min-height: 100vh;
            display: flex; 
            align-items: center; 
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        /* Ambient floating orbs */
        .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5; z-index: 0; animation: float 10s infinite ease-in-out; }
        .orb-1 { width: 400px; height: 400px; background: rgba(56, 189, 248, 0.4); top: -100px; left: -100px; }
        .orb-2 { width: 300px; height: 300px; background: rgba(59, 130, 246, 0.3); bottom: -50px; right: -50px; animation-delay: -5s; }

        @@keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 480px;
            z-index: 1;
            overflow: hidden;
            transform: translateY(20px);
            opacity: 0;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes slideUp {
            to { transform: translateY(0); opacity: 1; }
        }

        .auth-header {
            padding: 40px 40px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .auth-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #38bdf8, #2563eb);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: white;
            margin: 0 auto 20px;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            transform: rotate(-10deg);
            transition: all 0.3s ease;
        }

        .auth-card:hover .auth-icon {
            transform: rotate(0deg) scale(1.05);
        }

        .auth-title { color: #f8fafc; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 10px; }
        .auth-subtitle { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; }

        .auth-body { padding: 30px 40px 40px; }

        .form-floating { margin-bottom: 25px; position: relative; }
        .form-floating > .form-control {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255,255,255,0.1);
            color: #f8fafc;
            border-radius: 12px;
            padding-left: 20px;
            height: 60px;
            transition: all 0.3s ease;
        }
        
        .form-floating > .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
        }

        .form-floating > label { color: #64748b; padding-left: 20px; }
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #38bdf8;
            transform: scale(0.85) translateY(-0.75rem) translateX(0.15rem);
        }

        .btn-submit {
            background: linear-gradient(to right, #2563eb, #38bdf8);
            border: none;
            color: white;
            border-radius: 12px;
            height: 56px;
            font-weight: 600;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-submit::after {
            content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
            transform: skewX(-20deg); transition: all 0.5s ease;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.4);
            color: white;
        }
        
        .btn-submit:hover::after { left: 150%; }

        .back-link {
            display: inline-flex;
            align-items: center;
            color: #64748b;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .back-link:hover { color: #f8fafc; }
        .back-link i { margin-right: 8px; font-size: 0.85rem; transition: transform 0.3s ease; }
        .back-link:hover i { transform: translateX(-4px); }

        .alert-glass {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            border-radius: 12px;
            padding: 15px 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="container d-flex justify-content-center">
        <div class="auth-card">
            <div class="auth-header">
                <div class="auth-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
                <h3 class="auth-title">Recuperar Acceso</h3>
                <p class="auth-subtitle">Ingresa tu correo electrónico y enviaremos un enlace seguro a tu bandeja para restablecer tu cuenta.</p>
            </div>

            <div class="auth-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass mb-4 d-flex align-items-start">
                        <i class="fas fa-exclamation-circle mt-1 me-3 fs-5"></i>
                        <div>
                            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div class="mb-1">@e.ErrorMessage</div> }
                        </div>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Email" type="email" class="form-control" placeholder="nombre@correo.com" autocomplete="email" autofocus>
                        <label asp-for="Email">Correo Electrónico</label>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block px-3"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-submit d-flex align-items-center justify-content-center gap-2">
                            <span>Enviar Enlace Seguro</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>

                    <div class="text-center mt-2">
                        <a asp-action="Login" class="back-link">
                            <i class="fas fa-chevron-left"></i> Volver a inicio de sesión
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>